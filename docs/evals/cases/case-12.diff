+    [Fact]
+    public void Discard_DraftInvoice_RemovesIt()
+    {
+        var repository = new FakeInvoiceRepository();
+        repository.Add(new Invoice { Id = "INV-910", CustomerName = "Acme", Amount = 50m });
+        var service = new ApprovalService(repository);
+
+        service.Discard("INV-910");
+
+        Assert.Null(repository.GetById("INV-910"));
+    }
+
+    [Fact]
+    public void Discard_PendingInvoice_ThrowsAndKeepsIt()
+    {
+        var repository = new FakeInvoiceRepository();
+        repository.Add(Pending("INV-911"));
+        var service = new ApprovalService(repository);
+
+        Assert.Throws<InvalidOperationException>(() => service.Discard("INV-911"));
+        Assert.NotNull(repository.GetById("INV-911"));
+    }
